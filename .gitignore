/.idea/
/.gradle/
**/build/**

/gradle.properties
/build/

# Per-environment secrets, loaded by the local profiles via spring.config.import and copied by
# hand into the deployment platform. Only the placeholder template is tracked.
.env
.env.*
!.env.example
/.claude/
/.claire/
/k9x-backend-infrastructure/src/main/generated/
/gradle/

# New Relic Java agent: binaries are downloaded at build time
# (Dockerfile / `./gradlew unzipNewrelic`). Only the custom config is tracked,
# so the Docker build can COPY it into the image.
/newrelic/*
!/newrelic/newrelic.yml
