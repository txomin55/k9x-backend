# Template for the per-environment secret files. Copy it and fill in the real values:
#
#   .env.local         → profile `local`         (app + Postgres container on your machine)
#   .env.local-remote  → profile `local-remote`  (app on your machine, remote Supabase database)
#   .env.staging       → profile `deployed`      (values to paste into the platform, staging)
#   .env.production    → profile `deployed`      (values to paste into the platform, production)
#
# The two local files are read at startup by application-local.yml / application-local-remote.yml
# (spring.config.import). The staging/production files are not read by the app: they are the local
# record of what must be configured as environment variables on the platform (Render).
#
# Parsed as a .properties file, so: no quotes around values, no `export`, and `#` starts a comment.

# Which profile to activate. `local`, `local-remote` or `deployed`.
SPRING_PROFILES_ACTIVE=local

# --- Database -----------------------------------------------------------------------------------
# The `local` profile defaults to the Postgres container (localhost:2345, admin/password), so these
# can be left out there. Required for `local-remote` and `deployed`.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
HIKARI_MAX_POOL_SIZE=

# --- Auth ---------------------------------------------------------------------------------------
# JWT signing secret, 32 bytes minimum. Generate one with:
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(48)).decode().rstrip('='))"
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173

# --- Web Push (VAPID) ---------------------------------------------------------------------------
# One key pair per environment: the pair identifies the server to the push services, and the
# frontend must be configured with the matching PUBLIC key. Replacing a pair invalidates every
# existing subscription in that environment. Generate a new pair with:
#   openssl ecparam -name prime256v1 -genkey -noout -outform DER > k.der   # then base64url-encode
#   the 32-byte private scalar and the 65-byte uncompressed public point.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:txomin.sirera@gmail.com

# --- Misc ---------------------------------------------------------------------------------------
SERVER_PORT=4000
