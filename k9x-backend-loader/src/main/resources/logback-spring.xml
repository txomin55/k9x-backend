<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_FILE" value="LogFile"/>
    <property name="LOG_DIR" value="var/logs/k9x-backend"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender" additivity="false">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <springProfile name="local | local-remote">
        <logger name="org.springframework.web" level="DEBUG"/>
        <root level="DEBUG">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

    <springProfile name="deployed">
        <logger name="org.springframework" level="ERROR"/>
        <!-- The crons' INFO lines (how many events, how many records, the heap) are what tells a run that
             finished from one that died; under the WARN root they never reached the logs. -->
        <logger name="com.k9x.application.events.snapshot" level="INFO"/>
        <logger name="com.k9x.application.dogs.rank" level="INFO"/>
        <root level="WARN">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

    <!-- No profile active (e.g. tests): keep logs visible instead of silently dropping them. -->
    <springProfile name="!local &amp; !local-remote &amp; !deployed">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>
</configuration>
